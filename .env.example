# Copy to .env and fill in. .env is git-ignored.
#
# ── Single-server (default compose.yaml) ─────────────────────────
IPMI_HOST=192.168.1.100
IPMI_USER=ADMIN
IPMI_PASS=changeme
IPMI_BOARD=X11
IPMI_NAME=MyServer

# ── Multi-server (compose.multi.example.yaml + servers.yaml) ─────
# Each ${VAR} you reference in servers.yaml goes here:
# ATLAS_IPMI_PASS=changeme
# ESX3_IPMI_PASS=changeme

# ── Optional ─────────────────────────────────────────────────────
WEB_PORT=8080
POLL_INTERVAL=30
HISTORY_RETENTION_DAYS=30

# Alert thresholds (degrees C / RPM)
CPU_WARN_C=75
CPU_CRIT_C=90
INLET_WARN_C=45
FAN_MIN_RPM=500

# ── Disk monitoring (optional plugin) ────────────────────────────
# Off by default. Enable to monitor Unraid disk temps + capacity + SMART.
# Two source modes:
#   local — read /var/local/emhttp/disks.ini from a path mounted into the
#           container. Recommended when the dashboard runs on the same
#           Unraid box you want to monitor.
#   ssh   — SSH into a remote Unraid host and cat the file. Requires an
#           SSH key mounted read-only at DISKS_SSH_KEY.
#
# DISKS_ENABLED=1
# DISKS_SOURCE=local
# DISKS_LOCAL_PATH=/host/disks.ini
#
# # ssh mode only:
# DISKS_SSH_HOST=10.19.10.11
# DISKS_SSH_USER=root
# DISKS_SSH_KEY=/ssh_key
# DISKS_SSH_TIMEOUT=8
#
# Disk alert thresholds (defaults shown):
# DISK_WARN_C=40
# DISK_CRIT_C=50
# DISK_CAPACITY_WARN_PCT=85
# DISK_CAPACITY_CRIT_PCT=95

# ── Notifications (optional) ─────────────────────────────────────
# When set, the dashboard POSTs JSON to NOTIFY_WEBHOOK_URL on:
#   - alert.opened    (sensor breached threshold)
#   - alert.updated   (warn -> crit or vice versa)
#   - alert.cleared   (sensor returned to normal)
#   - power.action    (manual power on/off/cycle/reset)
#   - power.failed    (power command failed)
#
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
# NOTIFY_WEBHOOK_FORMAT=generic    # generic | discord | slack | ntfy
# NOTIFY_WEBHOOK_TIMEOUT=5         # seconds
